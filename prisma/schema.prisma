// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  phone         String?
  bio           String?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts  Account[]
  sessions  Session[]
  boats     Boat[]
  bookings  Booking[]
  reviews   Review[]
  favorites Favorite[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Boat {
  id            String      @id @default(cuid())
  title         String
  description   String      @db.Text
  type          BoatType
  capacity      Int
  length        Float
  year          Int?
  make          String?
  model         String?
  pricePerDay   Float
  pricePerHour  Float?
  minHours      Int?        @default(1)
  minDays       Int?        @default(1)
  images        String[]
  amenities     String[]
  rules         String?     @db.Text
  cancellationPolicy CancellationPolicy @default(FLEXIBLE)
  
  // Location
  country       String
  region        String
  city          String
  marina        String?
  latitude      Float?
  longitude     Float?
  
  // Status
  isActive      Boolean     @default(true)
  isVerified    Boolean     @default(false)
  
  ownerId       String
  owner         User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  
  bookings      Booking[]
  reviews       Review[]
  favorites     Favorite[]
  unavailability Unavailability[]

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([country, region])
  @@index([ownerId])
}

model Booking {
  id             String        @id @default(cuid())
  boatId         String
  renterId       String
  startDate      DateTime
  endDate        DateTime
  hours          Int?
  rentalType     RentalType
  guests         Int
  totalPrice     Float
  serviceFee     Float
  status         BookingStatus @default(PENDING)
  
  // Stripe
  paymentIntentId String?      @unique
  paymentStatus   PaymentStatus @default(PENDING)
  
  // Messages
  message        String?       @db.Text
  
  boat    Boat   @relation(fields: [boatId], references: [id])
  renter  User   @relation(fields: [renterId], references: [id])
  review  Review?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([boatId])
  @@index([renterId])
}

model Review {
  id        String   @id @default(cuid())
  boatId    String
  authorId  String
  bookingId String   @unique
  rating    Float
  comment   String   @db.Text
  
  boat    Boat    @relation(fields: [boatId], references: [id])
  author  User    @relation(fields: [authorId], references: [id])
  booking Booking @relation(fields: [bookingId], references: [id])

  createdAt DateTime @default(now())
}

model Favorite {
  id     String @id @default(cuid())
  userId String
  boatId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  boat Boat @relation(fields: [boatId], references: [id], onDelete: Cascade)

  @@unique([userId, boatId])
}

model Unavailability {
  id        String   @id @default(cuid())
  boatId    String
  startDate DateTime
  endDate   DateTime
  reason    String?

  boat Boat @relation(fields: [boatId], references: [id], onDelete: Cascade)
}

enum Role {
  USER
  ADMIN
}

enum BoatType {
  SAILBOAT
  MOTORBOAT
  YACHT
  CATAMARAN
  SPEEDBOAT
  HOUSEBOAT
  KAYAK
  JETSKI
  PONTOON
  FISHING
}

enum RentalType {
  HOURLY
  DAILY
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

enum CancellationPolicy {
  FLEXIBLE
  MODERATE
  STRICT
}
